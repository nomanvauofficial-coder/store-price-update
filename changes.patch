@@ -0,0 +1,10 @@
+# Supabase -> Project Settings -> Database -> Connection string
+# Pooled (Transaction, port 6543):
+DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
+# Direct (port 5432) - used for creating tables:
+DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres"
+
+# First login password (change it later from Admin -> Settings). Default: admin123
+ADMIN_PASSWORD="change-me"
+# Optional long random text for login cookie signing
+ADMIN_SECRET=""
